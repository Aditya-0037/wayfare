HEDERA_PAYER_ACCOUNT_ID=0.0.xxxxxxx
HEDERA_PAYER_PRIVATE_KEY=0xyourECDSAprivatekey
MAX_TOTAL_TINYBARS=5000000
MAX_PRICE_PER_CALL_TINYBARS=1000000
MAX_CALLS=5
BALANCE_FLOOR_TINYBARS=100000000
HCS_TOPIC_ID=0.0.xxxxxxx

# Sepolia key that holds the ROLE_SET_TEXT grant for wayfare.reputation on each provider's
# resolver (see packages/identity/README.md) — needed for the RECORD step's ENS half.
ENS_RECORDER_PRIVATE_KEY=0xyourSettlementRecorderKey

# Only relevant to `npm run serve` (the WebSocket server). Both no-op by default — a public
# deployment sets these to bound worst-case spend from a demo left running unattended.
# MIN_SECONDS_BETWEEN_RUNS=20
# LIFETIME_MAX_TINYBARS=20000000
# MAX_TEXT_LENGTH=4000
